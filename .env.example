# Isotopia — Firebase web config (OPTIONAL).
#
# The game runs fully offline with NO configuration (local question seed +
# localStorage). Only set these if you want the online features: the shared
# question bank, the teacher portal, and per-student progress sync.
#
# These are Firebase *web* config values (not secrets — they identify a project;
# access is controlled by the security rules in firebase/). Get them from the
# Firebase console -> Project settings -> Your apps -> Web app -> SDK config.
#
# In production (e.g. Netlify) set these as the site's Environment variables.
# For local builds, export them in your shell before `npm run build` / `watch`,
# or use a tool like dotenv-cli. They are injected at build time by rollup.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional "Support Isotopia" payment link (Ko-fi, GitHub Sponsors, Stripe
# Payment Link...). Must start with https://. Unset = support links hidden.
SUPPORT_URL=
